# =============================================================
# Sentinel OS v1.2 - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------
# DATABASE
# -----------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_os

# -----------------------------------------------------------
# SESSION
# -----------------------------------------------------------
SESSION_SECRET=your-session-secret-here

# -----------------------------------------------------------
# BLOCKCHAIN: Movement M1
# -----------------------------------------------------------
MOVEMENT_PRIVATE_KEY=your-movement-private-key
MOVEMENT_RPC_URL=https://aptos.testnet.porto.movementlabs.xyz/v1

# -----------------------------------------------------------
# BLOCKCHAIN: Ethereum / EVM
# -----------------------------------------------------------
PRIVATE_KEY=your-evm-private-key
ETHERSCAN_API_KEY=your-etherscan-api-key

# -----------------------------------------------------------
# AI: Google Gemini
# -----------------------------------------------------------
# Optional - Gemini 1.5 Flash for AI compliance analysis
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# -----------------------------------------------------------
# OBSERVABILITY: Opik (Comet ML)
# -----------------------------------------------------------
OPIK_API_KEY=your-opik-api-key
OPIK_PROJECT=polar-universal
OPIK_WORKSPACE=default

# -----------------------------------------------------------
# INTEGRATIONS: Miro
# -----------------------------------------------------------
# Optional - for compliance flow visualization
MIRO_ACCESS_TOKEN=your-miro-access-token
MIRO_BOARD_ID=your-miro-board-id

# -----------------------------------------------------------
# INTEGRATIONS: Sanity CMS
# -----------------------------------------------------------
# Optional - for compliance rule management
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token

# -----------------------------------------------------------
# REPLIT AUTH
# -----------------------------------------------------------
REPLIT_DOMAINS=your-repl.replit.app
ISSUER_URL=https://auth.replit.com
